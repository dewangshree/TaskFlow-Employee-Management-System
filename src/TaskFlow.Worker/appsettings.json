{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "",
    "RabbitMq": ""
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
    "WriteTo": [ { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } } ]
  },
  "Outbox": { "PollingIntervalMilliseconds": 2000, "BatchSize": 50, "MaxAttempts": 20, "RetentionDays": 7 },
  "RabbitMq": { "Exchange": "taskflow.events", "NotificationsQueue": "taskflow.notifications", "PrefetchCount": 10, "RetryDelaysSeconds": [ 5, 30, 120 ] }
}
