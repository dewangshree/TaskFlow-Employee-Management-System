{
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "DemoData": true,
    "AdminPassword": "Admin@123",
    "EmployeePassword": "Employee@123"
  },
  "Cache": {
    "DashboardTtlSeconds": 120,
    "ReferenceDataTtlSeconds": 600,
    "NotificationCountTtlSeconds": 300
  },
  "Redis": {
    "Enabled": true,
    "CircuitBreakSeconds": 30
  },
  "Outbox": {
    "BacklogWarningSeconds": 120,
    "MaxAttempts": 20
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Search": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Worker": {
    "RunInApi": true
  },
  "OpenApi": {
    "Enabled": true
  }
}